{
  "experiment_id": "GRAPH-OPTION-TRAIN64-001",
  "base_config": "run_r2r/iter_train.yaml",
  "checkpoint": "data/logs/checkpoints/release_r2r/ckpt.iter12000.pth",
  "split": "train",
  "episodes": 64,
  "seed": 100,
  "dataset_path": "research/results/graph_option_train64/sampling_001/train64_bertidx.json.gz",
  "sampling_manifest": "research/results/graph_option_train64/sampling_001/manifest.json",
  "capture_graph_options": true,
  "allow_sliding": true,
  "tryout_effective": false,
  "back_algo": "control",
  "replay_modes": [
    "sequential",
    "isolated_branch"
  ],
  "reverse_states_per_episode": 2,
  "reverse_selection_seed": 20261007,
  "gates": {
    "endpoint_tolerance_m": 1e-05,
    "rotation_tolerance_rad": 1e-05,
    "progress_tolerance_m": 1e-05,
    "primitive_action_sequence_exact": true,
    "per_primitive_collision_sequence_exact": true,
    "rng_post_exact": true,
    "terminal_flag_exact": true,
    "baseline_episode_metrics_tolerance": 1e-06
  },
  "analysis": {
    "primary": "Best admissible non-STOP full-option goal progress minus actually selected ghost; learned and forced STOP states excluded",
    "controls": [
      "candidate local to current observation",
      "primitive count no greater than selected",
      "movement path no longer than selected"
    ],
    "material_state_gain_m": 0.25,
    "bootstrap_seed": 20261007,
    "bootstrap_samples": 5000
  },
  "purpose": "Broaden training coverage before any fitting; audit cost-controlled local opportunity and ordered route compatibility.",
  "limits": "64 newly selected routes in 16 training scenes, one simulator seed. No learned improvement or causal failure claim. Same STOP, sensors, horizon and original controller.",
  "sampling": {
    "source": "data/datasets/R2R_VLNCE_v1-2_preprocessed_BERTidx/train/train_bertidx.json.gz",
    "exclude_manifest": "research/results/graph_option_pilot/train8_sampling/manifest.json",
    "scenes": 16,
    "routes_per_scene": 4,
    "seed": 20261007
  },
  "route_protocol": "research/ROUTE_COMPATIBILITY_PROTOCOL.md"
}
