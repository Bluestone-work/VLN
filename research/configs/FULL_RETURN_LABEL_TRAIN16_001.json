      "research/results/action_abstraction/ranker_embedding_train960_oracle.jsonl"
    ],
    "scenes": 8,
    "routes_per_scene": 2,
    "seed": 20261007
  },
  "continuation_protocol": "research/FULL_RETURN_LABEL_NEXT_GATE.md",
