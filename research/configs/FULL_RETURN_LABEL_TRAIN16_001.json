  "analysis": {
    "primary": "Full native continuation of outcome-blind state and two deployable candidate alternatives",
    "selection": "State and alternatives selected from metadata, masks and native graph logits only; no goal, reference route, branch outcome or final metric",
    "candidate_alternatives": ["highest_nonselected_native_logit", "seeded_valid_graph_id"],
    "bootstrap_seed": 20261007,
    "bootstrap_samples": 5000
  },
  "purpose": "Outcome-blind full-return diagnostic before any scorer fitting.",
  "limits": "16 training routes / 8 new-to-diagnostics scenes, one simulator seed. Privileged alternative rollout analysis; no learned model or held-out claim.",
  "sampling": {
    "source": "data/datasets/R2R_VLNCE_v1-2_preprocessed_BERTidx/train/train_bertidx.json.gz",
    "exclude_sources": [
