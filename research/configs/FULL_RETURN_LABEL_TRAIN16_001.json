  "checkpoint": "data/logs/checkpoints/release_r2r/ckpt.iter12000.pth",
  "split": "train",
  "episodes": 16,
  "seed": 100,
  "dataset_path": "research/results/full_return_label_train16/sampling_001/train16_bertidx.json.gz",
  "sampling_manifest": "research/results/full_return_label_train16/sampling_001/manifest.json",
  "capture_graph_options": true,
