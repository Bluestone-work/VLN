    "primitive_action_sequence_exact": true,
    "per_primitive_collision_sequence_exact": true,
    "rng_post_exact": true,
    "terminal_flag_exact": true,
    "baseline_episode_metrics_tolerance": 0.000001
  },
  "purpose": "Validate selected-option replay across all 11 unseen scenes, six distinct routes per scene, before collecting alternate options.",
  "limits": "Diagnostic subset, not a benchmark score. Static scenes, default sensors/controller, no noise; sliding=true disables tryout. Privileged distances are analysis-only."
