{
  "experiment_id": "OPTION-CALIBRATION-002",
  "base_config": "run_r2r/iter_train.yaml",
  "checkpoint": "data/logs/checkpoints/release_r2r/ckpt.iter12000.pth",
  "split": "val_unseen",
  "episodes": 66,
  "seed": 100,
  "dataset_path": "research/results/option_calibration/unseen_balanced66_sampling/val_unseen_balanced66_bertidx.json.gz",
